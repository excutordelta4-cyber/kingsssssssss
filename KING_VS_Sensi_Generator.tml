<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080808">
<meta name="description" content="KING.VS SENSI GENERATOR — sugestões de configuração para Free Fire.">
<title>KING.VS SENSI GENERATOR</title>
<style>
:root{--bg:#080808;--panel:#121212;--panel2:#191919;--red:#ed1010;--red2:#ff3636;--white:#f7f7f7;--muted:#aaa;--line:#3a1515}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at top,#260707 0,#080808 48%);color:var(--white);font-family:Arial,Helvetica,sans-serif;min-height:100vh}
header{text-align:center;padding:30px 16px 22px;border-bottom:1px solid var(--line);background:#090909d9}
.logo{font-weight:900;letter-spacing:2px;font-size:clamp(30px,8vw,48px);margin:0;color:#fff;text-shadow:0 0 16px #ed101077}
.logo span{color:var(--red)}
.subtitle{color:var(--muted);font-size:13px;letter-spacing:2px;margin:8px 0 0}
main{width:min(100% - 28px,560px);margin:24px auto 45px}
.panel{background:linear-gradient(145deg,#171717,#0e0e0e);border:1px solid #4b1717;border-radius:18px;padding:20px;box-shadow:0 12px 35px #0009}
h2{font-size:19px;margin:0 0 16px}
.section{margin-bottom:22px}
label{display:block;font-size:13px;font-weight:700;color:#ff6666;margin:0 0 8px}
select,input{width:100%;padding:13px 12px;background:#080808;border:1px solid #4a2929;border-radius:10px;color:#fff;font-size:15px;outline:none}
select:focus,input:focus{border-color:var(--red);box-shadow:0 0 0 2px #ed101022}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.choice{border:1px solid #542020;background:#0a0a0a;color:#eee;border-radius:11px;padding:14px 8px;font-weight:800;cursor:pointer;transition:.18s}
.choice small{display:block;color:#aaa;font-weight:400;font-size:11px;margin-top:5px}
.choice.active{border-color:var(--red);background:#390909;box-shadow:0 0 14px #ed101033;color:#fff}
.primary,.secondary{width:100%;border-radius:11px;padding:15px;border:1px solid var(--red);font-weight:900;letter-spacing:1px;cursor:pointer}
.primary{background:linear-gradient(90deg,#a90000,#ed1010);color:#fff}
.secondary{background:#111;color:#fff;margin-top:10px}
.primary:active,.secondary:active,.choice:active{transform:scale(.99)}
.note{font-size:12px;line-height:1.5;color:#aaa}
.hidden{display:none!important}
.results{margin-top:20px;padding-top:18px;border-top:1px solid #442020}
.result-row{display:flex;justify-content:space-between;gap:12px;padding:11px 4px;border-bottom:1px solid #292020;font-size:14px}
.result-row strong{color:#ff5555;font-size:16px}
.pill{display:inline-block;background:#310909;color:#ff7777;border:1px solid #742020;border-radius:20px;padding:6px 10px;font-size:11px;margin:3px 0 12px}
.notice{border:1px solid #653333;background:#1c0d0d;border-radius:10px;padding:12px;color:#ddd;font-size:12px;line-height:1.5;margin-top:14px}
.tiktok{display:block;text-decoration:none;text-align:center;margin-top:18px;padding:14px;border-radius:11px;background:#111;border:1px solid #ed1010;color:#fff;font-weight:900}
.confirm{display:flex;gap:10px;align-items:flex-start;margin-top:12px;font-size:13px;color:#ddd;line-height:1.4}
.confirm input{width:18px;height:18px;margin:0;accent-color:red;flex:none}
footer{text-align:center;color:#777;font-size:11px;padding:0 20px 28px}
@media(max-width:380px){.panel{padding:15px}.grid{gap:8px}.choice{padding:12px 5px}}
</style>
</head>
<body>
<header>
  <h1 class="logo">KING<span>.</span>VS</h1>
  <p class="subtitle">SENSI GENERATOR • FREE FIRE</p>
</header>

<main>
  <section class="panel">
    <h2>👑 Monte sua configuração</h2>

    <div class="section">
      <label for="brand">1. MARCA DO CELULAR</label>
      <select id="brand">
        <option value="">Selecione a marca</option>
        <option>Apple</option><option>Samsung</option><option>Motorola</option>
        <option>Xiaomi</option><option>Redmi</option><option>POCO</option>
        <option>Realme</option><option>ASUS</option><option>Outra marca</option>
      </select>
    </div>

    <div class="section">
      <label for="model">2. MODELO DO CELULAR</label>
      <select id="model">
        <option value="">Primeiro selecione a marca</option>
      </select>
      <input id="customModel" class="hidden" style="margin-top:9px" placeholder="Digite a marca e o modelo do aparelho">
    </div>

    <div class="section">
      <label>3. ESCOLHA O ESTILO DE SENSIBILIDADE</label>
      <div class="grid" id="styles">
        <button type="button" class="choice" data-style="baixa">BAIXA<small>0 a 90 • controle</small></button>
        <button type="button" class="choice" data-style="mediana">MEDIANA<small>90 a 130 • equilíbrio</small></button>
        <button type="button" class="choice" data-style="alta">ALTA<small>120 a 200 • velocidade</small></button>
        <button type="button" class="choice" data-style="controle">CONTROLE<small>atendimento personalizado</small></button>
      </div>
    </div>

    <button type="button" class="primary" id="generate">GERAR SENSI</button>
    <p class="note">As configurações são sugestões iniciais. O resultado pode variar conforme aparelho, atualização do jogo e preferência de cada jogador.</p>

    <div id="controlInfo" class="notice hidden">
      <strong>ESTILO CONTROLE</strong><br>
      Para receber uma configuração personalizada, entre em contato com o criador <strong>@freetyle01112</strong>. O link de WhatsApp ainda não foi configurado.
    </div>

    <div id="result" class="results hidden" aria-live="polite">
      <span class="pill" id="resultStyle"></span>
      <h2>🔥 SUA SENSI KING.VS</h2>
      <div id="values"></div>
      <div class="notice" id="dpiInfo"></div>
      <button type="button" class="secondary" id="copy">COPIAR CONFIGURAÇÃO</button>
    </div>

    <a class="tiktok" href="https://www.tiktok.com/@freetyle01112" target="_blank" rel="noopener noreferrer">SEGUIR NO TIKTOK ↗</a>
    <label class="confirm">
      <input type="checkbox" id="followConfirm">
      <span>Confirmo que visitei o perfil e segui @freetyle01112. (Confirmação manual; o site não verifica seguidores automaticamente.)</span>
    </label>
    <p class="note">A confirmação é apenas declaratória e não comprova o seguimento.</p>
  </section>

  <section class="notice" style="max-width:560px;margin:16px auto 0">
    <strong>Limite e licenças:</strong> esta versão é uma demonstração no navegador. O limite seguro de 200 gerações por dia, licenças e controle administrativo exigem servidor e banco de dados; não estão ativos neste HTML.
  </section>
</main>

<footer>KING.VS • @freetyle01112<br>Free Fire é uma marca de seus respectivos proprietários. Este projeto não é afiliado à Garena.</footer>

<script>
const models = {
  Apple: ["iPhone 1","iPhone 3G","iPhone 3GS","iPhone 4","iPhone 4s","iPhone 5","iPhone 5c","iPhone 5s","iPhone 6","iPhone 6 Plus","iPhone 6s","iPhone 6s Plus","iPhone SE (1ª geração)","iPhone 7","iPhone 7 Plus","iPhone 8","iPhone 8 Plus","iPhone X","iPhone XR","iPhone XS","iPhone XS Max","iPhone 11","iPhone 11 Pro","iPhone 11 Pro Max","iPhone SE (2ª geração)","iPhone 12 mini","iPhone 12","iPhone 12 Pro","iPhone 12 Pro Max","iPhone 13 mini","iPhone 13","iPhone 13 Pro","iPhone 13 Pro Max","iPhone SE (3ª geração)","iPhone 14","iPhone 14 Plus","iPhone 14 Pro","iPhone 14 Pro Max","iPhone 15","iPhone 15 Plus","iPhone 15 Pro","iPhone 15 Pro Max","iPhone 16","iPhone 16 Plus","iPhone 16 Pro","iPhone 16 Pro Max","iPhone 16e","iPhone 17","iPhone 17 Pro","iPhone 17 Pro Max","iPhone Air"],
  Samsung: ["Galaxy A05","Galaxy A05s","Galaxy A06","Galaxy A15","Galaxy A16","Galaxy A25","Galaxy A26","Galaxy A35","Galaxy A36","Galaxy A55","Galaxy A56","Galaxy S21","Galaxy S21 FE","Galaxy S22","Galaxy S22+","Galaxy S22 Ultra","Galaxy S23","Galaxy S23 FE","Galaxy S23+","Galaxy S23 Ultra","Galaxy S24","Galaxy S24 FE","Galaxy S24+","Galaxy S24 Ultra","Galaxy S25","Galaxy S25+","Galaxy S25 Ultra","Galaxy M15","Galaxy M34","Galaxy M35","Galaxy M55","Galaxy Z Flip","Galaxy Z Fold"],
  Motorola: ["Moto G04","Moto G05","Moto G14","Moto G24","Moto G34","Moto G54","Moto G55","Moto G64","Moto G75","Moto G84","Moto G85","Edge 40","Edge 40 Neo","Edge 50 Fusion","Edge 50 Pro","Edge 50 Ultra","Edge 60","Edge 60 Pro","Razr 50"],
  Xiaomi: ["Xiaomi 12","Xiaomi 12T","Xiaomi 13","Xiaomi 13T","Xiaomi 13T Pro","Xiaomi 14","Xiaomi 14T","Xiaomi 14T Pro","Xiaomi 15","Xiaomi 15 Ultra"],
  Redmi: ["Redmi 12","Redmi 13C","Redmi 13","Redmi Note 12","Redmi Note 12 Pro","Redmi Note 13","Redmi Note 13 Pro","Redmi Note 13 Pro+","Redmi Note 14","Redmi Note 14 Pro","Redmi Note 14 Pro+"],
  POCO: ["POCO C65","POCO C75","POCO M6","POCO M6 Pro","POCO X5 Pro","POCO X6","POCO X6 Pro","POCO X7","POCO X7 Pro","POCO F5","POCO F6","POCO F6 Pro","POCO F7"],
  Realme: ["Realme C53","Realme C55","Realme C65","Realme C67","Realme 11 Pro","Realme 12","Realme 12 Pro+","Realme 13 Pro","Realme GT 6"],
  ASUS: ["ROG Phone 6","ROG Phone 7","ROG Phone 8","ROG Phone 9","Zenfone 10","Zenfone 11 Ultra"],
  "Outra marca": ["Outro modelo (digitar manualmente)"]
};
const brand = document.getElementById("brand");
const model = document.getElementById("model");
const customModel = document.getElementById("customModel");
let selectedStyle = "";
let lastConfig = "";
let currentText = "";

brand.addEventListener("change", () => {
  model.innerHTML = '<option value="">Selecione o modelo</option>';
  (models[brand.value] || []).forEach(name => {
    const option = document.createElement("option");
    option.value = name; option.textContent = name; model.appendChild(option);
  });
  customModel.classList.toggle("hidden", brand.value !== "Outra marca");
});
model.addEventListener("change", () => {
  customModel.classList.toggle("hidden", !(brand.value === "Outra marca" || model.value.includes("digitar manualmente")));
});

document.querySelectorAll(".choice").forEach(button => {
  button.addEventListener("click", () => {
    selectedStyle = button.dataset.style;
    document.querySelectorAll(".choice").forEach(b => b.classList.toggle("active", b === button));
    document.getElementById("controlInfo").classList.toggle("hidden", selectedStyle !== "controle");
    document.getElementById("result").classList.add("hidden");
  });
});

function rand(min,max){ return Math.floor(Math.random()*(max-min+1))+min; }
function uniqueConfig(range, isApple) {
  let config, tries=0;
  do {
    config = {
      "Geral":rand(range[0],range[1]),
      "Red Dot":rand(range[0],range[1]),
      "Mira 2x":rand(range[0],range[1]),
      "Mira 4x":rand(range[0],range[1]),
      "AWM":rand(Math.max(0,range[0]-35),Math.min(200,range[1])),
      "Olhadinha":rand(range[0],range[1]),
      "Botão de tiro":rand(38,60)
    };
    tries++;
  } while(JSON.stringify(config)===lastConfig && tries<30);
  lastConfig=JSON.stringify(config);
  return config;
}
document.getElementById("generate").addEventListener("click", () => {
  if(!document.getElementById("followConfirm").checked){
    alert("Visite o TikTok e marque a confirmação manual para liberar o gerador.");
    return;
  }
  if(!brand.value){alert("Selecione a marca do celular.");return;}
  const manual = customModel.value.trim();
  const chosenModel = (brand.value==="Outra marca" || model.value.includes("digitar manualmente")) ? manual : model.value;
  if(!chosenModel){alert("Selecione ou digite o modelo do celular.");return;}
  if(!selectedStyle){alert("Escolha um estilo de sensibilidade.");return;}
  if(selectedStyle==="controle"){
    document.getElementById("controlInfo").classList.remove("hidden");
    document.getElementById("result").classList.add("hidden");
    return;
  }
  let range;
  if(selectedStyle==="baixa") range=[0,90];
  if(selectedStyle==="mediana") range=[90,130];
  if(selectedStyle==="alta") range=[120,200];
  const isApple=brand.value==="Apple";
  const config=uniqueConfig(range,isApple);
  const names={baixa:"BAIXA",mediana:"MEDIANA",alta:"ALTA"};
  document.getElementById("resultStyle").textContent=names[selectedStyle]+" • "+chosenModel;
  const values=document.getElementById("values");
  values.replaceChildren();
  Object.entries(config).forEach(([name,value])=>{
    const row=document.createElement("div"); row.className="result-row";
    const label=document.createElement("span"); label.textContent=name;
    const strong=document.createElement("strong"); strong.textContent=value;
    row.append(label,strong); values.appendChild(row);
  });
  document.getElementById("dpiInfo").textContent=isApple
    ? "DPI: iPhone não oferece um ajuste convencional de DPI como Android. Não é necessário alterar configurações do sistema para usar esta sugestão."
    : "DPI: mantenha o DPI padrão do aparelho como ponto de partida. Se você já usa um ajuste de DPI no Android, evite mudanças extremas e faça alterações pequenas nas configurações do sistema por sua conta.";
  currentText="KING.VS SENSI GENERATOR\nAparelho: "+brand.value+" "+chosenModel+"\nEstilo: "+names[selectedStyle]+"\n"+
    Object.entries(config).map(([k,v])=>k+": "+v).join("\n")+"\n"+document.getElementById("dpiInfo").textContent;
  document.getElementById("result").classList.remove("hidden");
});
document.getElementById("copy").addEventListener("click", async()=>{
  if(!currentText)return;
  try{
    await navigator.clipboard.writeText(currentText);
    alert("Configuração copiada!");
  }catch(e){
    const area=document.createElement("textarea");area.value=currentText;document.body.appendChild(area);area.select();
    const ok=document.execCommand("copy");area.remove();alert(ok?"Configuração copiada!":"Não foi possível copiar. Selecione e copie o texto manualmente.");
  }
});
</script>
</body>
</html>
